@host = http://localhost:5063
# Paste ids from responses here.
@jobId = REPLACE_WITH_JOB_ID
@appId = REPLACE_WITH_APPLICATION_ID

GET {{host}}/health

###
# Sign in first: recruiter endpoints need the auth cookie (the REST client keeps it for later requests).
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "recruiter@hirelens.dev", "password": "dev-recruiter-pass-2026" }

###
# Create a job
POST {{host}}/api/jobs
Content-Type: application/json

{
  "title": "Software Engineer",
  "location": "Remote",
  "descriptionText": "Build ASP.NET Core APIs in C# backed by MongoDB, with plain JavaScript frontends.",
  "mustHaveSkills": ["C#", "MongoDB", "JavaScript"],
  "niceToHaveSkills": ["Python", "Docker"]
}

###
GET {{host}}/api/jobs

###
GET {{host}}/api/jobs/{{jobId}}

###
# Edit / close (omit "status" to keep the current one)
PUT {{host}}/api/jobs/{{jobId}}
Content-Type: application/json

{
  "title": "Software Engineer",
  "location": "Remote",
  "descriptionText": "Build ASP.NET Core APIs in C# backed by MongoDB, with plain JavaScript frontends.",
  "mustHaveSkills": ["C#", "MongoDB"],
  "niceToHaveSkills": ["Python"],
  "status": "open"
}

###
# Suggest skills from a job description (calls NER; 503 if it's down)
POST {{host}}/api/jobs/extract-skills
Content-Type: application/json

{ "descriptionText": "Build ASP.NET Core APIs in C# backed by MongoDB, with plain JavaScript frontends." }

###
# Apply (skills are extracted from resumeText by NER)
POST {{host}}/api/jobs/{{jobId}}/applications
Content-Type: application/json

{
  "name": "Alice Example",
  "email": "alice@example.com",
  "resumeText": "Backend engineer with six years of C# and ASP.NET Core, MongoDB and some JavaScript at Infosys in Pune."
}

###
GET {{host}}/api/jobs/{{jobId}}/applications

###
GET {{host}}/api/applications/{{appId}}

###
PATCH {{host}}/api/applications/{{appId}}/status
Content-Type: application/json

{ "status": "shortlisted" }

###
# Re-run NER on a pending application (409 if already done, 503 if NER is still down)
POST {{host}}/api/applications/{{appId}}/retry-ner
